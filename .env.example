# CleanCopy / Trendzo Environment Variables

# Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# AI Services
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# Gemini AI (Required for Gemini 3 Pro Preview Analysis Component)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key
# Alternative environment variable name (both work):
# GEMINI_API_KEY=your_gemini_api_key

# Whisper (Transcription)
OPENAI_API_KEY=your_openai_key_for_whisper

# Apify (Video Scraping)
APIFY_API_TOKEN=your_apify_token

# Cling AI (Video Generation)
CLING_API_KEY=your_cling_api_key

# Other Services
RESEND_API_KEY=your_resend_key

# Stripe — paid-path checkout for the Escape Assessment.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_PRICE_ID_ESCAPE_ASSESSMENT=your_stripe_price_id
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Public site URL used in Stripe success/cancel redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Secret for signing the HttpOnly cookie that gates the code-path redirect
# to /free/freedom-os. Generate with: openssl rand -base64 32
CODE_PATH_COOKIE_SECRET=your_long_random_string

# AM Step 4: when true, auto-nudge route logs intent but does not send emails. Default true for safety.
AUTO_NUDGE_DRY_RUN=true

# Meta Pixel — base pixel + conversion events on techyai.co funnel pages only.
# The pixel is gated server-side by DEPLOY_TARGET=funnel, so leaving this
# unset on the Trendzo deploy is the correct configuration.
NEXT_PUBLIC_META_PIXEL_ID=
