# .understandignore — aggressive ignore for whole-repo /understand analysis
# Syntax: same as .gitignore. ! negates. Trailing / is dir-only.
#
# Built-in defaults already exclude: node_modules/, .git/, dist/, build/, obj/,
# *.lock, *.min.js, *.png, *.jpg, *.svg, etc.
# Patterns below add to those defaults.

# ============================================================
# SENSITIVE — never analyze (contain secrets)
# ============================================================
.env
.env.*
*.env
.supasecrets.env
.npmrc.backup
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
auth.json

