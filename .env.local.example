# Stripe — paid-path checkout for the Escape Assessment ($97).
# Use TEST mode keys (sk_test_..., pk_test_..., price_...) until ready
# to take real payments. See VERIFICATION_STRIPE_CHECKOUT.md for setup steps.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID_ESCAPE_ASSESSMENT=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL used in Stripe success/cancel redirects (no trailing slash).
# Localhost during development; the production domain when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Secret used to sign the HttpOnly cookie that gates /free/freedom-os
# for users coming through the code-redemption path.
# Generate with: openssl rand -base64 32
CODE_PATH_COOKIE_SECRET=replace_with_long_random_string

# Meta Pixel — base pixel + conversion events on techyai.co funnel pages only.
# The pixel is gated server-side by DEPLOY_TARGET=funnel, so leaving this
# unset on the Trendzo deploy is the correct configuration. For local
# verification of funnel pages, set this in .env.funnel together with
# DEPLOY_TARGET=funnel.
NEXT_PUBLIC_META_PIXEL_ID=
